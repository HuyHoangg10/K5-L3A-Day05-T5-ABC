# Sao chép thành .env rồi điền key của bạn. KHÔNG commit file .env.
# Dùng OpenAI (key bắt đầu bằng sk-):
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Hoặc dùng Anthropic (key bắt đầu bằng sk-ant-), chỉ dùng khi không có OPENAI_API_KEY:
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# PORT=3000

